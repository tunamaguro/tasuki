{
    "version": "2",
    "plugins": [
        {
            "name": "sqlc-gen-rust",
            "wasm": {
                "url": "https://github.com/tunamaguro/sqlc-gen-rust/releases/download/v0.1.10/sqlc-gen-rust.wasm",
                "sha256": "5cebd5288dd5cd91fe31b7c0395773cbb84eebffe54c190cfea074b56efe6427"
            }
        }
    ],
    "sql": [
        {
            "schema": "./tasuki-sqlx/migrations/*.sql",
            "queries": "./tasuki-sqlx/queries/",
            "engine": "postgresql",
            "codegen": [
                {
                    "plugin": "sqlc-gen-rust",
                    "out": "tasuki-postgres/src/",
                    "options": {
                        "output": "queries.rs",
                        "db_crate": "tokio-postgres",
                        "overrides": [
                            {
                                "db_type": "void",
                                "rs_type": "crate::PgVoid",
                                "copy_cheap": true
                            },
                            {
                                "db_type": "pg_catalog.interval",
                                "rs_type": "crate::PgInterval",
                                "copy_cheap": true
                            }
                        ]
                    }
                },
                {
                    "plugin": "sqlc-gen-rust",
                    "out": "tasuki-sqlx/src/",
                    "options": {
                        "output": "queries.rs",
                        "db_crate": "sqlx-postgres",
                        "overrides": [
                            {
                                "db_type": "uuid",
                                "rs_type": "sqlx::types::Uuid",
                                "copy_cheap": true
                            },
                            {
                                "db_type": "void",
                                "rs_type": "()",
                                "copy_cheap": true
                            },
                            {
                                "db_type": "timestamptz",
                                "rs_type": "crate::PgDateTime",
                                "copy_cheap": true
                            }
                        ]
                    }
                }
            ]
        }
    ]
}